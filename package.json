{
  "name": "probably-stolen-calculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Unofficial, free, local character builder for the game Probably Stolen (Phase 1).",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -p . --noEmit && vite build",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "preview": "vite preview --port 4173",
    "export-data": "vite-node scripts/export-data.ts",
    "example:dream-dust": "vite-node scripts/dream-dust-example.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^31.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-node": "^2.1.9",
    "vitest": "^2.0.5"
  }
}
